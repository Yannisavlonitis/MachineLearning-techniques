trainIndex <- createDataPartition(data$Diagnosis, p = 0.8, list = FALSE)
data$Diagnosis <- as.factor(data$Diagnosis)
trainData <- data[trainIndex,]
testData <- data[-trainIndex,]
knnModel <- train(Diagnosis ~ .,
data = trainData,
method = "knn",
trControl = trainControl(method = "cv", number = 10),
preProcess = c("center", "scale"),
tuneLength = 30)
plot(knnModel)
knnModel
predictions_knn <- predict(knnModel, newdata = testData )
# 5. Evaluar la precisión del modelo gracias a la matriz de confusión
conf_knn <- confusionMatrix(predictions_knn, testData$Diagnosis)
conf_knn
