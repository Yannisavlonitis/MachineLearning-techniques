# ....... SVM lineal ........................................................
set.seed(42)
svmModelLineal <- train(Diagnosis ~.,
data = trainData,
method = "svmLinear",
trControl = trainControl(method = "cv", number = 10),
preProcess = c("center", "scale"),
tuneGrid = expand.grid(C = seq(0, 2, length = 20)),
# Busca el parametro de coste C optimo ya que un
# C grande lleva al sobreajuste y C pequeño al infraajuste
prob.model = TRUE)
svmModelLineal
# Realizar predicciones en el conjunto de prueba utilizando el modelo entrenado
predictions_svm <- predict(svmModelLineal, newdata = testData )
predictions_svm
# Evaluar la precisión del modelo utilizando la matriz de confusión
conf_svm <- confusionMatrix(predictions_svm, testData$Diagnosis)
conf_svm
